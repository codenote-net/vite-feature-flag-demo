# Feature Flags (Environment Variable Pattern)
# All feature flags must be prefixed with VITE_FF_ to be exposed to the client
# Values: "true" or "false" (case-insensitive)

# Enable experimental checkout feature
VITE_FF_EXPERIMENTAL_CHECKOUT=false

# Enable new analytics dashboard
VITE_FF_ANALYTICS_DASHBOARD=true

# Enable A/B testing variant
VITE_FF_AB_TEST_VARIANT=false

# Enable maintenance mode
VITE_FF_MAINTENANCE_MODE=false
